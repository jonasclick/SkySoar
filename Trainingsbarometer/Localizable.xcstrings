        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SkySoar przechowuje wszystkie Twoje dane lokalnie na urządzeniu.\nTwoje dane pozostają offline i nie są dostępne dla nikogo innego."
