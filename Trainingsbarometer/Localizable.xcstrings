{
  "sourceLanguage" : "en",
  "strings" : {
    "\nAll sample flights have been removed. Double check your flight data before trusting the indicated practice state." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Beispiel-Flüge wurden entfernt. Überprüfe stets deine Flugdaten, bevor du dem angezeigten Übungsstand vertraust."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie przykładowe loty zostały usunięte. Przed zaufaniem wskazywanemu stanowi praktyki dokładnie sprawdź swoje dane lotu."
          }
        }
      }
    },
    "\nTen sample flights have been added. Therefore do not mistake the practice state shown in the app with your own practice state!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Beispiel-Flüge wurden hinzugefügt. Der gezeigte Übungsstand entspricht nun nicht deinem eigenen!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodano dziesięć przykładowych lotów. Dlatego nie myl wskazywanemu w aplikacji stanu praktyki ze swoim własnym stanem praktyki!\n"
          }
        }
      }
    },
